{
  "name": "telegram-video-player-nextjs",
  "version": "1.0.0",
  "private": true,
  "description": "Next.js lecture player with the existing Telegram streaming backend",
  "scripts": {
    "postinstall": "node scripts/patch-videojs-gesture-window.js",
    "dev": "cross-env NODE_ENV=development TELEGRAM_LOCAL_SERVICE=true node server.js",
    "build": "prisma generate && next build --webpack",
    "start": "cross-env NODE_ENV=production TELEGRAM_LOCAL_SERVICE=true node server.js",
    "rename-videos": "node src/telegram/videoRenamer.js"
  },
  "dependencies": {
    "@heroui/react": "^3.2.6",
    "@heroui/styles": "^3.2.6",
    "@prisma/adapter-pg": "^7.10.0",
    "@prisma/client": "^7.10.0",
    "@tailwindcss/postcss": "^4.3.3",
    "@videojs/react": "10.2.0",
    "cross-env": "^10.1.0",
    "dotenv": "^17.4.2",
    "express": "^5.1.0",
    "next": "^16.0.0",
    "pg": "^8.23.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tailwindcss": "^4.3.3",
    "teleproto": "^1.229.1"
  },
  "devDependencies": {
    "@types/pg": "^8.23.1",
    "prisma": "^7.10.0",
    "tsx": "^4.23.15"
  },
  "engines": {
    "node": "22.x"
  }
}
